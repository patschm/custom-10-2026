<Window x:Class="WpfLingo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfLingo"
        Title="Lingo" Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One letter tile; colours match the console version -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:LetterTile}">
            <Border x:Name="Tile" Width="52" Height="52" Margin="3" CornerRadius="4"
                    Background="White" BorderBrush="#BBBBBB" BorderThickness="2">
                <TextBlock x:Name="Text" Text="{Binding Character}" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:LetterState.Incorrect}">
                    <Setter TargetName="Tile" Property="Background" Value="#1E5AA8" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#1E5AA8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:LetterState.WrongPosition}">
                    <Setter TargetName="Tile" Property="Background" Value="#E0A800" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#E0A800" />
                    <Setter TargetName="Text" Property="Foreground" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:LetterState.Correct}">
                    <Setter TargetName="Tile" Property="Background" Value="#2E9E44" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#2E9E44" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Players -->
        <Grid IsEnabled="{Binding IsSetupEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label Content="Speler 1:" />
            <TextBox x:Name="Player1Box" Grid.Column="1" Text="Kees" Margin="0,2" VerticalContentAlignment="Center" />
            <Label Grid.Row="1" Content="Speler 2:" />
            <TextBox x:Name="Player2Box" Grid.Row="1" Grid.Column="1" Text="Jan" Margin="0,2" VerticalContentAlignment="Center" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Start" Width="80" Padding="4" Click="Start_Click" IsEnabled="{Binding IsSetupEnabled}" />
            <Button Content="Stoppen" Width="80" Padding="4" Margin="6,0,0,0" Click="Stop_Click" IsEnabled="{Binding IsGameRunning}" />
        </StackPanel>

        <!-- Status -->
        <TextBlock Text="{Binding Message}" FontSize="16" FontWeight="SemiBold" Margin="0,12" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <!-- Word to guess (only drawn by a DEBUG build of LingoGame) -->
        <StackPanel Visibility="{Binding HasSolution, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
            <TextBlock Text="Te raden woord (DEBUG)" Foreground="Gray" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Solution}" ItemTemplate="{StaticResource TileTemplate}"
                          ItemsPanel="{StaticResource HorizontalPanel}" Opacity="0.6" />
        </StackPanel>

        <!-- Board -->
        <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource TileTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Input -->
        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding IsInputEnabled}">
            <Button DockPanel.Dock="Right" Content="Raden" Width="80" Margin="6,0,0,0" Click="Guess_Click" IsDefault="True" />
            <TextBox x:Name="GuessBox" FontSize="20" CharacterCasing="Upper" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock Margin="0,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Een woord dat geen 5 letters heeft is ongeldig: dan is de andere speler aan de beurt." />
    </StackPanel>
</Window>
